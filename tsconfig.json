{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@engine/*": ["./engine/*"],
      "@game/*": ["./games/deungbul/*"]
    }
  },
  "include": ["engine", "games/deungbul", "test", "scripts", "vite.config.ts"]
}
