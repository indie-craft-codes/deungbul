{
  "name": "deungbul",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node scripts/game.mjs watch",
    "dev:client": "node scripts/game.mjs client",
    "build": "node scripts/game.mjs build",
    "build:all": "node scripts/game.mjs build all",
    "start": "node scripts/game.mjs start",
    "games": "node scripts/game.mjs list",
    "pilot": "node scripts/pilot.mjs",
    "admin": "node scripts/admin.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:engine": "node scripts/typecheck.mjs engine",
    "typecheck:game": "node scripts/typecheck.mjs",
    "test": "tsx test/all.ts",
    "test:engine": "tsx test/all.ts --engine",
    "test:game": "node scripts/game.mjs test",
    "load": "tsx games/deungbul/test/load.ts",
    "load:game": "node scripts/load.mjs",
    "econ": "tsx games/deungbul/scripts/econ.ts",
    "build:bastion": "node scripts/game.mjs build bastion",
    "build:cave": "node scripts/game.mjs build cave",
    "build:sample": "node scripts/game.mjs build sample",
    "build:starmine": "node scripts/game.mjs build starmine",
    "dev:bastion": "concurrently -n server,client -c yellow,cyan \"node scripts/game.mjs watch bastion\" \"node scripts/game.mjs client bastion\"",
    "dev:sample": "concurrently -n server,client -c yellow,cyan \"node scripts/game.mjs watch sample\" \"node scripts/game.mjs client sample\"",
    "dev:starmine": "concurrently -n server,client -c yellow,cyan \"node scripts/game.mjs watch starmine\" \"node scripts/game.mjs client starmine\"",
    "start:bastion": "node scripts/game.mjs start bastion",
    "start:cave": "node scripts/game.mjs start cave",
    "start:sample": "node scripts/game.mjs start sample",
    "start:starmine": "node scripts/game.mjs start starmine",
    "test:bastion": "node scripts/game.mjs test bastion",
    "test:cave": "node scripts/game.mjs test cave",
    "test:sample": "node scripts/game.mjs test sample",
    "test:starmine": "node scripts/game.mjs test starmine"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
