{
  "name": "deungbul",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node scripts/game.mjs watch",
    "dev:client": "node scripts/game.mjs client",
    "build": "node scripts/game.mjs build",
    "start": "node scripts/game.mjs start",
    "dev:sample": "concurrently -n server,client -c yellow,cyan \"node scripts/game.mjs watch sample\" \"node scripts/game.mjs client sample\"",
    "build:sample": "node scripts/game.mjs build sample",
    "start:sample": "node scripts/game.mjs start sample",
    "pilot": "node scripts/pilot.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p games/deungbul/tsconfig.json && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p engine/test/fx/tsconfig.json && tsc --noEmit -p games/sample/tsconfig.engine.json && tsc --noEmit -p games/sample/tsconfig.json",
    "typecheck:engine": "tsc --noEmit -p tsconfig.engine.json",
    "typecheck:engine:sample": "tsc --noEmit -p games/sample/tsconfig.engine.json",
    "typecheck:sample": "tsc --noEmit -p games/sample/tsconfig.json",
    "test": "tsx test/all.ts",
    "test:engine": "tsx test/all.ts --engine",
    "test:game": "node scripts/game.mjs test",
    "test:sample": "node scripts/game.mjs test sample",
    "load": "tsx games/deungbul/test/load.ts",
    "econ": "tsx games/deungbul/scripts/econ.ts"
  },
  "dependencies": {
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
